# ---------------------------------------------------------------------------
# Wattalis · sitio público
# Copia este archivo como .env.local y completa lo que tengas.
# Todas las variables son opcionales: sin ellas el sitio arranca en modo demo.
# La mayoría de las páginas se generan al compilar: tras cambiar cualquier
# variable, vuelve a ejecutar `npm run build`.
# ---------------------------------------------------------------------------

# URL pública del sitio, sin diagonal final. Se usa en URL canónicas,
# Open Graph, robots.txt y sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL de la aplicación privada (agenda, caja, etc.).
# Si se deja vacía, se omiten todos los enlaces «Acceso al sistema» y /planes
# muestra precios ilustrativos sin contratación en línea. En desarrollo, si la
# aplicación corre en el puerto 3001: http://localhost:3001
NEXT_PUBLIC_WATTALIS_APP_URL=

# Indexación en buscadores. Solo con «true» se permite indexar.
# Déjalo vacío en demostración, staging y vistas previas.
WATTALIS_ALLOW_INDEXING=

# Fuente de datos del directorio. Valor admitido hoy: demo.
# Consulta «Sustituir la fuente de datos» en el README.
WATTALIS_DATA_SOURCE=demo

# Canal comercial: destino de «Contactar a Wattalis» y de /contacto.
WATTALIS_SALES_EMAIL=
WATTALIS_SALES_PHONE=

# Contacto institucional general (/contacto).
WATTALIS_CONTACT_EMAIL=
WATTALIS_CONTACT_PHONE=

# Redes sociales (pie de página y /contacto). URL completas https://
WATTALIS_SOCIAL_FACEBOOK=
WATTALIS_SOCIAL_INSTAGRAM=
WATTALIS_SOCIAL_LINKEDIN=
